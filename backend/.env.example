# GitHub personal access token — used by /analyze-pr for PR metadata, commits and diffs.
# Leave empty to allow only unauthenticated (rate-limited) GitHub API calls.
GITHUB_TOKEN=

# Optional resource limits (defaults shown)
# MAX_REPO_SIZE_MB=200
# CLONE_TIMEOUT_SECONDS=120
# MAX_SCAN_FILES=3000
# MAX_FILE_SIZE_MB=2
# SCAN_TIME_BUDGET_SECONDS=300

# Optional sandbox limits for git/semgrep subprocesses (defaults shown)
# SANDBOX_MEMORY_MB=1024
# SANDBOX_MAX_PROCS=256
# SANDBOX_NO_NETWORK=0

# GitHub App webhook (POST /webhook/github)
# Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_ID=
# Paste the full PEM private key, escaping newlines as \n
# GITHUB_APP_PRIVATE_KEY=

# Redis connection for the arq job queue (default shown)
# REDIS_URL=redis://localhost:6379/0

# Webhook job reliability (defaults shown).
# Duplicate GitHub deliveries (same X-GitHub-Delivery) are deduped automatically.
# Transient failures (network errors, GitHub 429/5xx) are retried with
# exponential backoff; once WEBHOOK_MAX_TRIES is exhausted the job is parked
# in the "dead_letter" state on the jobs table.
# WEBHOOK_MAX_TRIES=5
# WEBHOOK_RETRY_BASE_SECONDS=30
# WEBHOOK_RETRY_MAX_SECONDS=3600

# PostgreSQL for scan history (repos, pull_requests, jobs, findings, reviews).
# Optional — leave unset to run without persistence. Render-style postgres://
# URLs are normalized automatically. Apply migrations with: alembic upgrade head
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_code_review

# Optional LLM review (Gemini). Off by default. Uses Redis caching with a 7-day TTL
# when available; results are cached by provider/model/prompt_version/head_sha.
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_API_KEY=
# If gemini-3.8-flash is unavailable (HTTP 503), try gemini-3.5-flash-lite.
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_INPUT_CHARS=120000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_FINDINGS=10
LLM_MIN_CONFIDENCE=0.6
LLM_ALLOW_PRIVATE_REPOS=false
LLM_CACHE_TTL_SECONDS=604800
